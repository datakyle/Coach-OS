rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The two Firebase Auth accounts from js/firebase-config.js. Checking the
    // exact email matters: anyone can create *some* Firebase account with your
    // public API key, so "is signed in" alone would let strangers read.
    function isCoach() {
      return request.auth != null
        && request.auth.token.email == 'coach@coach-os.app';
    }
    function isTeam() {
      return isCoach()
        || (request.auth != null && request.auth.token.email == 'team@coach-os.app');
    }

    // Shared plays. Team code can read. Coach code can read, upload, delete.
    match /plays/{playId} {
      allow read: if isTeam();

      allow create, update: if isCoach()
        && request.resource.data.keys().hasOnly(['name', 'data', 'updated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() < 120
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000
        && request.resource.data.updated is int;

      allow delete: if isCoach();
    }

    // Everything else is closed.
  }
}
