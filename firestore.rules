rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The one Firebase Auth account from js/firebase-config.js; its password
    // unlocks Coach OS. Checking the exact email matters: anyone can create
    // *some* Firebase account with your public API key, so "is signed in"
    // alone would let strangers in.
    function isCoach() {
      return request.auth != null
        && request.auth.token.email == 'coach@coach-os.app';
    }

    // One shared record: a name, the record as a JSON string, a timestamp.
    function validRecord() {
      return request.resource.data.keys().hasOnly(['name', 'data', 'updated'])
        && request.resource.data.name is string
        && request.resource.data.name.size() < 120
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000
        && request.resource.data.updated is int;
    }

    // Shared plays and published practices. Signed in: read, share, remove.
    match /plays/{playId} {
      allow read: if isCoach();
      allow create, update: if isCoach() && validRecord();
      allow delete: if isCoach();
    }
    match /practices/{day} {
      allow read: if isCoach();
      allow create, update: if isCoach() && validRecord();
      allow delete: if isCoach();
    }

    // Everything else is closed.
  }
}
